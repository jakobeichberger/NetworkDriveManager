<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="NetworkDriveManager.Views.HelpDialog"
        Height="500" Width="520"
        WindowStartupLocation="CenterOwner" CanResize="False"
        Background="#f5f7fa">

    <DockPanel LastChildFill="True" Margin="10">

        <!-- Close button at the bottom -->
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right"
                    Margin="0,10,0,0">
            <Button Content="{Binding CloseText}" Click="OnClose" MinWidth="80"
                    Background="Transparent" Foreground="#374151"
                    BorderBrush="#d1d5db" BorderThickness="1" Padding="14,6"
                    FontSize="12"/>
        </StackPanel>

        <!-- Scrollable help text -->
        <TextBox Text="{Binding HelpContent, Mode=OneWay}" IsReadOnly="True"
                 TextWrapping="Wrap" AcceptsReturn="True"
                 Background="#f5f7fa" Foreground="#1a1a2e"
                 FontSize="10"
                 BorderThickness="0" Padding="10"/>
    </DockPanel>
</Window>
