<Window x:Class="NetworkDriveManager.Views.SettingsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding SettingsTitle}" Height="700" Width="700"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResize"
        Background="#f5f7fa">

    <Window.Resources>
        <Style x:Key="AccentButton" TargetType="Button">
            <Setter Property="Background" Value="#c62828"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="14,6"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}"
                                CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#8b0000"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="OutlinedButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#c62828"/>
            <Setter Property="BorderBrush" Value="#c62828"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="14,6"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#ffe0e0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DangerOutlinedButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#b71c1c"/>
            <Setter Property="BorderBrush" Value="#b71c1c"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="14,6"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#ffe0e0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="NeutralButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#374151"/>
            <Setter Property="BorderBrush" Value="#d1d5db"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="14,6"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#e5e7eb"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <DockPanel LastChildFill="True" Margin="10">

        <!-- ══════════════ SAVE / CANCEL (bottom) ══════════════ -->
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right"
                    Margin="0,10,0,0">
            <Button Content="{Binding CancelText}" Style="{StaticResource NeutralButton}"
                    Click="OnCancel" Margin="0,0,5,0"/>
            <Button Content="{Binding SaveText}" Style="{StaticResource AccentButton}"
                    Click="OnSave"/>
        </StackPanel>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>

                <!-- ══════════════ DRIVE LIST (DataGrid) ══════════════ -->
                <DataGrid x:Name="DriveGrid" AutoGenerateColumns="False"
                          ItemsSource="{Binding Drives}" SelectedItem="{Binding SelectedDrive}"
                          SelectionMode="Single" CanUserAddRows="False" CanUserDeleteRows="False"
                          IsReadOnly="True" HeadersVisibility="Column"
                          Height="220" Margin="0,0,0,5"
                          FontFamily="Segoe UI" FontSize="10"
                          GridLinesVisibility="Horizontal"
                          HorizontalGridLinesBrush="#d1d5db">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="{Binding DataContext.LetterHeader,
                            RelativeSource={RelativeSource AncestorType=Window}}"
                            Binding="{Binding Letter}" Width="60"/>
                        <DataGridTextColumn Header="{Binding DataContext.ServerHeader,
                            RelativeSource={RelativeSource AncestorType=Window}}"
                            Binding="{Binding Server}" Width="160"/>
                        <DataGridTextColumn Header="{Binding DataContext.ShareHeader,
                            RelativeSource={RelativeSource AncestorType=Window}}"
                            Binding="{Binding Share}" Width="140"/>
                        <DataGridTextColumn Header="{Binding DataContext.LabelHeader,
                            RelativeSource={RelativeSource AncestorType=Window}}"
                            Binding="{Binding Label}" Width="160"/>
                        <DataGridTextColumn Header="{Binding DataContext.HiddenHeader,
                            RelativeSource={RelativeSource AncestorType=Window}}"
                            Binding="{Binding HiddenDisplay}" Width="55"/>
                    </DataGrid.Columns>
                </DataGrid>

                <!-- ══════════════ TREE ACTION BUTTONS ══════════════ -->
                <WrapPanel Margin="0,0,0,5">
                    <Button Content="{Binding NewText}" Style="{StaticResource OutlinedButton}"
                            Click="OnNew" MinWidth="70" Margin="0,0,5,0"/>
                    <Button Content="{Binding AddText}" Style="{StaticResource OutlinedButton}"
                            Click="OnAdd" MinWidth="80" Margin="0,0,5,0"/>
                    <Button Content="{Binding EditText}" Style="{StaticResource OutlinedButton}"
                            Click="OnEdit" MinWidth="90" Margin="0,0,5,0"/>
                    <Button Content="{Binding RemoveText}" Style="{StaticResource DangerOutlinedButton}"
                            Click="OnRemove" MinWidth="90" Margin="0,0,5,0"/>
                    <Button Content="{Binding ImportText}" Style="{StaticResource OutlinedButton}"
                            Click="OnImport" MinWidth="90" HorizontalAlignment="Right"/>
                </WrapPanel>

                <!-- ══════════════ ENTRY FORM ══════════════ -->
                <TextBlock Text="{Binding FormTitle}" Foreground="#c62828"
                           FontFamily="Segoe UI" FontSize="11" FontWeight="Bold"
                           Margin="5,5,0,3"/>
                <Border Background="White" BorderBrush="#d1d5db" BorderThickness="1"
                        CornerRadius="6" Padding="10" Margin="0,0,0,5">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Letter -->
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="{Binding LetterHeader, StringFormat='{}{0}:'}"
                                   FontFamily="Segoe UI" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBox Grid.Row="0" Grid.Column="1"
                                 Text="{Binding FormLetter, UpdateSourceTrigger=PropertyChanged}"
                                 MaxLength="1" FontFamily="Segoe UI" Padding="4,3"/>
                        <TextBlock Grid.Row="0" Grid.Column="2" Text="●" FontSize="10"
                                   Foreground="{Binding LetterIndicatorColor}"
                                   VerticalAlignment="Center" Margin="4,0,8,0"/>

                        <!-- Server -->
                        <TextBlock Grid.Row="0" Grid.Column="3" Text="{Binding ServerHeader, StringFormat='{}{0}:'}"
                                   FontFamily="Segoe UI" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBox Grid.Row="0" Grid.Column="4"
                                 Text="{Binding FormServer, UpdateSourceTrigger=PropertyChanged}"
                                 FontFamily="Segoe UI" Padding="4,3"/>
                        <TextBlock Grid.Row="0" Grid.Column="5" Text="●" FontSize="10"
                                   Foreground="{Binding ServerIndicatorColor}"
                                   VerticalAlignment="Center" Margin="4,0,0,0"/>

                        <!-- Hints row 1 -->
                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding LetterHint}"
                                   Foreground="{Binding LetterHintColor}" FontFamily="Segoe UI"
                                   FontSize="8" Margin="0,1,0,4"/>
                        <TextBlock Grid.Row="1" Grid.Column="4" Text="{Binding ServerHint}"
                                   Foreground="{Binding ServerHintColor}" FontFamily="Segoe UI"
                                   FontSize="8" Margin="0,1,0,4"/>

                        <!-- Share -->
                        <TextBlock Grid.Row="2" Grid.Column="0" Text="{Binding ShareHeader, StringFormat='{}{0}:'}"
                                   FontFamily="Segoe UI" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBox Grid.Row="2" Grid.Column="1"
                                 Text="{Binding FormShare, UpdateSourceTrigger=PropertyChanged}"
                                 FontFamily="Segoe UI" Padding="4,3"/>
                        <TextBlock Grid.Row="2" Grid.Column="2" Text="●" FontSize="10"
                                   Foreground="{Binding ShareIndicatorColor}"
                                   VerticalAlignment="Center" Margin="4,0,8,0"/>

                        <!-- Label -->
                        <TextBlock Grid.Row="2" Grid.Column="3" Text="{Binding LabelHeader, StringFormat='{}{0}:'}"
                                   FontFamily="Segoe UI" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBox Grid.Row="2" Grid.Column="4"
                                 Text="{Binding FormLabel, UpdateSourceTrigger=PropertyChanged}"
                                 FontFamily="Segoe UI" Padding="4,3"/>
                        <TextBlock Grid.Row="2" Grid.Column="5" Text="●" FontSize="10"
                                   Foreground="{Binding LabelIndicatorColor}"
                                   VerticalAlignment="Center" Margin="4,0,0,0"/>

                        <!-- Hints row 3 -->
                        <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding ShareHint}"
                                   Foreground="{Binding ShareHintColor}" FontFamily="Segoe UI"
                                   FontSize="8" Margin="0,1,0,4"/>
                        <TextBlock Grid.Row="3" Grid.Column="4" Text="{Binding LabelHint}"
                                   Foreground="{Binding LabelHintColor}" FontFamily="Segoe UI"
                                   FontSize="8" Margin="0,1,0,4"/>

                        <!-- Hidden checkbox -->
                        <CheckBox Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="3"
                                  Content="{Binding HiddenHeader}"
                                  IsChecked="{Binding FormHidden}" Margin="0,5,0,0"/>
                    </Grid>
                </Border>

                <!-- ══════════════ CONNECTION LOG ══════════════ -->
                <DockPanel Margin="0,5,0,3">
                    <TextBlock Text="{Binding LogTitle}" Foreground="#c62828"
                               FontFamily="Segoe UI" FontSize="11" FontWeight="Bold"
                               VerticalAlignment="Center" DockPanel.Dock="Left" Margin="5,0"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" DockPanel.Dock="Right">
                        <Button Content="{Binding LogRefreshText}" Style="{StaticResource OutlinedButton}"
                                Click="OnLogRefresh" MinWidth="90" Margin="0,0,5,0"/>
                        <Button Content="{Binding LogExportCsvText}" Style="{StaticResource OutlinedButton}"
                                Click="OnLogExportCsv" MinWidth="90" Margin="0,0,5,0"/>
                        <Button Content="{Binding LogClearText}" Style="{StaticResource DangerOutlinedButton}"
                                Click="OnLogClear" MinWidth="90"/>
                    </StackPanel>
                </DockPanel>

                <Border Background="White" BorderBrush="#d1d5db" BorderThickness="1"
                        CornerRadius="6" Padding="4" Margin="0,0,0,3">
                    <TextBox x:Name="LogTextBox" IsReadOnly="True" TextWrapping="NoWrap"
                             AcceptsReturn="True" VerticalScrollBarVisibility="Auto"
                             HorizontalScrollBarVisibility="Auto"
                             FontFamily="Consolas" FontSize="9"
                             Background="White" Foreground="#1a1a2e"
                             BorderThickness="0" Height="140"/>
                </Border>

                <TextBlock Text="{Binding LogFileLabel}" Foreground="#6b7280"
                           FontFamily="Segoe UI" FontSize="8" Margin="5,2,0,0"/>

            </StackPanel>
        </ScrollViewer>

    </DockPanel>
</Window>
