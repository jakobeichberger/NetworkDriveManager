<Window x:Class="NetworkDriveManager.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="{Binding WindowTitle}"
        MinHeight="420" MinWidth="560"
        Height="640" Width="620"
        WindowStartupLocation="CenterScreen"
        Background="#f5f7fa">

    <Window.Resources>
        <!-- Shared colours -->
        <SolidColorBrush x:Key="AccentBrush" Color="#c62828"/>
        <SolidColorBrush x:Key="AccentDarkBrush" Color="#8b0000"/>
        <SolidColorBrush x:Key="ConnectedBrush" Color="#2e7d32"/>
        <SolidColorBrush x:Key="DisconnectedBrush" Color="#b71c1c"/>
        <SolidColorBrush x:Key="SeparatorBrush" Color="#d1d5db"/>
        <SolidColorBrush x:Key="BgBrush" Color="#f5f7fa"/>
        <SolidColorBrush x:Key="HintBrush" Color="#6b7280"/>
        <SolidColorBrush x:Key="HeaderTextBrush" Color="#374151"/>

        <!-- Accent button style (filled red) -->
        <Style x:Key="AccentButton" TargetType="Button">
            <Setter Property="Background" Value="#c62828"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="14,6"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}"
                                CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#8b0000"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Outlined button style (transparent bg, accent border) -->
        <Style x:Key="OutlinedButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#c62828"/>
            <Setter Property="BorderBrush" Value="#c62828"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="14,6"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#ffe0e0"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Neutral outlined button -->
        <Style x:Key="NeutralButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#374151"/>
            <Setter Property="BorderBrush" Value="#d1d5db"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="14,6"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#e5e7eb"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- BoolToVisibility converter -->
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </Window.Resources>

    <DockPanel LastChildFill="True">

        <!-- ══════════════ STATUS BAR (bottom) ══════════════ -->
        <Border DockPanel.Dock="Bottom" BorderBrush="#d1d5db" BorderThickness="0,1,0,0">
            <Border Background="#e8edf2" Padding="8,4">
                <TextBlock Text="{Binding StatusMessage}" FontFamily="Segoe UI" FontSize="9"
                           Foreground="{Binding StatusColor}" TextWrapping="Wrap"/>
            </Border>
        </Border>

        <!-- ══════════════ HEADER BANNER ══════════════ -->
        <Border DockPanel.Dock="Top" Background="#c62828" Padding="12,8">
            <StackPanel Orientation="Horizontal">
                <Image x:Name="LogoImage" Height="72" Margin="0,0,8,0" VerticalAlignment="Center"/>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{Binding WindowTitle}" Foreground="White" FontFamily="Segoe UI"
                               FontSize="18" FontWeight="Bold"/>
                    <TextBlock Text="{Binding AppSubtitle}" Foreground="White"
                               FontFamily="Segoe UI" FontSize="10"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- ══════════════ TOOLBAR (Help, Settings, Language) ══════════════ -->
        <DockPanel DockPanel.Dock="Top" Margin="10,5,10,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" DockPanel.Dock="Right">
                <Button Content="{Binding SettingsText}" Style="{StaticResource OutlinedButton}"
                        Command="{Binding OpenSettingsCommand}" Margin="0,0,5,0" MinWidth="85"/>
                <Button Content="{Binding HelpText}" Style="{StaticResource OutlinedButton}"
                        Command="{Binding OpenHelpCommand}" Margin="0,0,5,0" MinWidth="60"/>
                <Button Content="{Binding LangButtonText}" Style="{StaticResource AccentButton}"
                        Command="{Binding ToggleLanguageCommand}" MinWidth="85"/>
            </StackPanel>
            <TextBlock/> <!-- spacer -->
        </DockPanel>

        <!-- ══════════════ SCROLLABLE CONTENT ══════════════ -->
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="10,5,10,10">

                <!-- ══════════════ CREDENTIALS SECTION ══════════════ -->
                <TextBlock Text="{Binding CredentialsHeader}" Foreground="#c62828"
                           FontFamily="Segoe UI" FontSize="11" FontWeight="Bold" Margin="5,5,0,3"/>
                <Border Background="White" BorderBrush="#d1d5db" BorderThickness="1" CornerRadius="6"
                        Padding="10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Username -->
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="{Binding UsernameLabel}"
                                   FontFamily="Segoe UI" FontSize="10" VerticalAlignment="Center"
                                   Margin="0,0,8,0"/>
                        <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}"
                                 FontFamily="Segoe UI" FontSize="10" Padding="4,3"/>
                        <TextBlock Grid.Row="0" Grid.Column="2" Text="●" FontSize="10"
                                   Foreground="{Binding UsernameIndicatorColor}" VerticalAlignment="Center"
                                   Margin="4,0,0,0"/>
                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding UsernameHintText}"
                                   Foreground="{Binding UsernameHintColor}" FontFamily="Segoe UI"
                                   FontSize="8" Margin="0,1,0,4"/>

                        <!-- Password -->
                        <TextBlock Grid.Row="2" Grid.Column="0" Text="{Binding PasswordLabel}"
                                   FontFamily="Segoe UI" FontSize="10" VerticalAlignment="Center"
                                   Margin="0,0,8,0"/>
                        <PasswordBox Grid.Row="2" Grid.Column="1" x:Name="PasswordBox"
                                     FontFamily="Segoe UI" FontSize="10" Padding="4,3"
                                     PasswordChanged="PasswordBox_PasswordChanged"/>
                        <TextBlock Grid.Row="2" Grid.Column="2" Text="●" FontSize="10"
                                   Foreground="{Binding PasswordIndicatorColor}" VerticalAlignment="Center"
                                   Margin="4,0,0,0"/>
                        <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding PasswordHintText}"
                                   Foreground="{Binding PasswordHintColor}" FontFamily="Segoe UI"
                                   FontSize="8" Margin="0,1,0,4"/>

                        <!-- Save Credentials button -->
                        <Button Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="3"
                                Content="{Binding SaveCredentialsText}"
                                Style="{StaticResource AccentButton}"
                                Command="{Binding SaveCredentialsCommand}"
                                HorizontalAlignment="Right" Margin="0,8,0,0"/>
                    </Grid>
                </Border>

                <!-- ══════════════ WARNINGS PANEL ══════════════ -->
                <StackPanel Visibility="{Binding HasWarnings, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="{Binding WarningsHeader}" Foreground="#e65100"
                               FontFamily="Segoe UI" FontSize="11" FontWeight="Bold"
                               Margin="5,5,0,1"/>
                    <Border Background="#fff3e0" BorderBrush="#ffb74d" BorderThickness="1"
                            CornerRadius="6" Padding="5" Margin="0,0,0,5">
                        <ItemsControl ItemsSource="{Binding Warnings}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <DockPanel Margin="3,2">
                                        <Button DockPanel.Dock="Right" Content="×" FontSize="12"
                                                Command="{Binding DataContext.DismissWarningCommand,
                                                    RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding Key}"
                                                Background="Transparent" BorderThickness="0"
                                                Foreground="#e65100" Cursor="Hand" Padding="4,2"
                                                Margin="4,0,0,0"/>
                                        <TextBlock Text="{Binding Message}" Foreground="#e65100"
                                                   FontFamily="Segoe UI" FontSize="10"
                                                   TextWrapping="Wrap"/>
                                    </DockPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Border>
                </StackPanel>

                <!-- ══════════════ NETWORK DRIVES SECTION ══════════════ -->
                <TextBlock Text="{Binding NetworkDrivesHeader}" Foreground="#c62828"
                           FontFamily="Segoe UI" FontSize="11" FontWeight="Bold" Margin="5,5,0,3"/>
                <Border Background="#f5f7fa" BorderBrush="#d1d5db" BorderThickness="1" CornerRadius="6"
                        Padding="5">
                    <StackPanel>
                        <!-- Header Row -->
                        <Grid Margin="0,2,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="50"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="90"/>
                                <ColumnDefinition Width="130"/>
                                <ColumnDefinition Width="110"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{Binding DriveHeader}"
                                       FontWeight="Bold" FontFamily="Segoe UI" FontSize="10"
                                       Foreground="#374151" Margin="5,0,0,0"/>
                            <TextBlock Grid.Column="1" Text="{Binding PathHeader}"
                                       FontWeight="Bold" FontFamily="Segoe UI" FontSize="10"
                                       Foreground="#374151" Margin="10,0,0,0"/>
                            <TextBlock Grid.Column="2" Text="{Binding StatusHeader}"
                                       FontWeight="Bold" FontFamily="Segoe UI" FontSize="10"
                                       Foreground="#374151" Margin="10,0,0,0"/>
                            <TextBlock Grid.Column="3" Text="{Binding ServerCheckHeader}"
                                       FontWeight="Bold" FontFamily="Segoe UI" FontSize="10"
                                       Foreground="#374151" Margin="10,0,0,0"/>
                            <TextBlock Grid.Column="4" Text="{Binding ActionHeader}"
                                       FontWeight="Bold" FontFamily="Segoe UI" FontSize="10"
                                       Foreground="#374151" Margin="10,0,0,0"/>
                        </Grid>

                        <Separator Background="#d1d5db" Margin="5,5"/>

                        <!-- Drive Rows -->
                        <ItemsControl ItemsSource="{Binding DriveRows}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="50"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="90"/>
                                            <ColumnDefinition Width="130"/>
                                            <ColumnDefinition Width="110"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Drive Letter -->
                                        <TextBlock Grid.Column="0" FontFamily="Segoe UI" FontSize="10"
                                                   VerticalAlignment="Center" Margin="5,0,0,0">
                                            <Run Text="{Binding Letter, Mode=OneWay}"/><Run Text=":"/>
                                        </TextBlock>

                                        <!-- Path -->
                                        <TextBlock Grid.Column="1" Text="{Binding DisplayPath}"
                                                   FontFamily="Segoe UI" FontSize="10"
                                                   TextTrimming="CharacterEllipsis"
                                                   VerticalAlignment="Center" Margin="10,0,0,0"/>

                                        <!-- Status -->
                                        <TextBlock Grid.Column="2" Text="{Binding StatusText}"
                                                   Foreground="{Binding StatusColor}"
                                                   FontFamily="Segoe UI" FontSize="10"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center" Margin="10,0,0,0"/>

                                        <!-- Server Check Button -->
                                        <Button Grid.Column="3" Content="{Binding ServerCheckText}"
                                                Command="{Binding DataContext.CheckServerCommand,
                                                    RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}"
                                                IsEnabled="{Binding DataContext.IsNotBusy,
                                                    RelativeSource={RelativeSource AncestorType=Window}}"
                                                FontFamily="Segoe UI" FontSize="10"
                                                Cursor="Hand" Margin="10,1,0,1"
                                                Foreground="White" Padding="6,3">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border x:Name="bd" CornerRadius="4"
                                                            Background="{Binding ServerCheckColor}"
                                                            Padding="{TemplateBinding Padding}">
                                                        <ContentPresenter HorizontalAlignment="Center"
                                                                          VerticalAlignment="Center"/>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsEnabled" Value="False">
                                                            <Setter TargetName="bd" Property="Opacity" Value="0.6"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Button.Template>
                                        </Button>

                                        <!-- Toggle (Connect/Disconnect) Button -->
                                        <Button Grid.Column="4" Content="{Binding ToggleButtonText}"
                                                Command="{Binding DataContext.ToggleDriveCommand,
                                                    RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}"
                                                IsEnabled="{Binding DataContext.IsNotBusy,
                                                    RelativeSource={RelativeSource AncestorType=Window}}"
                                                FontFamily="Segoe UI" FontSize="10"
                                                Cursor="Hand" Margin="10,1,0,1"
                                                Foreground="White" Padding="6,3">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border x:Name="bd" CornerRadius="4"
                                                            Background="{Binding ToggleButtonColor}"
                                                            Padding="{TemplateBinding Padding}">
                                                        <ContentPresenter HorizontalAlignment="Center"
                                                                          VerticalAlignment="Center"/>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsEnabled" Value="False">
                                                            <Setter TargetName="bd" Property="Opacity" Value="0.6"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Button.Template>
                                        </Button>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- ══════════════ ACTION BUTTONS ══════════════ -->
                <DockPanel Margin="0,8,0,0">
                    <Button DockPanel.Dock="Right" Content="{Binding RefreshStatusText}"
                            Style="{StaticResource NeutralButton}"
                            Command="{Binding RefreshStatusCommand}"
                            IsEnabled="{Binding IsNotBusy}"/>
                    <StackPanel Orientation="Horizontal">
                        <Button Content="{Binding ConnectAllText}"
                                Style="{StaticResource AccentButton}"
                                Command="{Binding ConnectAllCommand}"
                                IsEnabled="{Binding IsNotBusy}" Margin="0,0,5,0"/>
                        <Button Content="{Binding DisconnectAllText}"
                                Style="{StaticResource OutlinedButton}"
                                Command="{Binding DisconnectAllCommand}"
                                IsEnabled="{Binding IsNotBusy}"/>
                    </StackPanel>
                </DockPanel>

            </StackPanel>
        </ScrollViewer>

    </DockPanel>
</Window>
